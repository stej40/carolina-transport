# Local development profile - copy to .env.local (git-ignored) and adjust.
# Selected by APP_ENV=local (the default when APP_ENV is unset).
# Real environment variables always override values in this file.

APP_ENV=local

# Enable interactive docs at /api/docs + /api/openapi.json
DEBUG=true

DATABASE_URL=postgresql+asyncpg://karolina:karolina@localhost:5432/karolina
SECRET_KEY=dev-only-secret-change-me-0123456789abcdef
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30

# S3-compatible object storage (Garage in dev, see infra/docker-compose.yml)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=GKf1e2d3c4b5a69788796a5b4c
S3_SECRET_KEY=a1b2c3d4e5f60718293a4b5c6d7e8f90a1b2c3d4e5f60718293a4b5c6d7e8f90
S3_BUCKET=karolina-documents
S3_REGION=garage
PRESIGN_TTL_SEC=900

# CORS - JSON list
CORS_ORIGINS=["http://localhost:5173","http://localhost:5174"]
