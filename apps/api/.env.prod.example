# Production profile - copy to .env.prod ON THE VPS ONLY (never committed),
# place it in the API working directory (container WORKDIR /app),
# and start the API with APP_ENV=prod. Deployment is owned by
# openspec/changes/mvp1-deploy-pilot.
# Startup FAILS in prod if this file is missing, DEBUG=true, or SECRET_KEY
# is the dev placeholder / shorter than 32 characters.

APP_ENV=prod

DEBUG=false

DATABASE_URL=postgresql+asyncpg://karolina:CHANGE_ME@postgres:5432/karolina
SECRET_KEY=CHANGE_ME-unique-random-value-at-least-32-chars-long
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30

# S3-compatible object storage (Garage)
S3_ENDPOINT=http://garage:3900
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
S3_BUCKET=karolina-documents
S3_REGION=garage
PRESIGN_TTL_SEC=900

# CORS - JSON list, production origin(s) only
CORS_ORIGINS=["https://karolina.example.cz"]
